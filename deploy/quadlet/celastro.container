# celastro from its published image, run by systemd through podman: a
# quadlet. Put this file at /etc/containers/systemd/celastro.container and
# the settings at /etc/celastro/celastro.env (celastro.env beside this file
# is the shape), then:
#
#   systemctl daemon-reload && systemctl start celastro
#
# An upgrade is the Image= line changed and the two commands again.
# Podman 4.4 or later; every current distribution ships it.
[Unit]
Description=celastro, a hybrid document database
Documentation=https://github.com/celastro/celastro
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/celastro/celastro:0.72.1
ContainerName=celastro
# The host's network: the console on 8787 and the wire on 7876 are the
# machine's own ports, as they would be for the binary installed directly,
# and CELASTRO_NODE can name the machine's address.
Network=host
# A named volume, seeded from the image's /data with its ownership (UID
# 65532), so nothing is prepared by hand. `podman volume inspect
# celastro-data` says where it is on the host.
Volume=celastro-data:/data
EnvironmentFile=/etc/celastro/celastro.env
# For one node drop `--shard-bind 0.0.0.0:7876`; the wire is a cluster's.
Exec=--dir /data serve --bind 0.0.0.0 --shard-bind 0.0.0.0:7876
# `serve` prints its URL on stdout -- without the token, since the token
# came from the environment file and this line lands in the journal --
# and the log on stderr.
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=2
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target default.target

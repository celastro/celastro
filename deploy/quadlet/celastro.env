# The settings for the quadlet's container: /etc/celastro/celastro.env,
# readable by root only (chmod 0600). The same variables `celastro install`
# writes for the binary; docs/tuning.md has the rest.

# The token every client presents: at least sixteen printable bytes, the
# same on every node of a cluster.
CELASTRO_TOKEN=change-this-to-a-long-random-token

# A node of a cluster: its own wire address, every node's address (the same
# list on every node; its own is skipped), and the secret the wire shares.
# Leave them out for one node.
CELASTRO_NODE=tcp://10.0.0.2:7876
CELASTRO_ATTACH=tcp://10.0.0.2:7876,tcp://10.0.0.3:7876,tcp://10.0.0.4:7876
CELASTRO_WIRE_TOKEN=change-this-too

# TLS: the three files from `celastro tls init`, mounted into the container
# (add `Volume=/etc/celastro/tls:/tls:ro,Z` to the quadlet).
#CELASTRO_TLS_CERT=/tls/tls.crt
#CELASTRO_TLS_KEY=/tls/tls.key
#CELASTRO_TLS_CA=/tls/ca.crt
#CELASTRO_TLS_CLIENT_AUTH=required

# Encryption at rest: the master key and the wrapped data key, mounted the
# same way.
#CELASTRO_MASTER_KEY_FILE=/keys/master.key
#CELASTRO_KEY_FILE=/keys/data.key
